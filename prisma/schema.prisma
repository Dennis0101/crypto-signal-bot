// SaaS foundation schema (security-first, multi-tenant)
// NOTE:
// - Row-Level Security (RLS) is enforced via SQL migrations (see prisma/migrations/*).
// - Prisma does not "understand" RLS, so the API server must set the request user context
//   in Postgres (e.g. set_config('app.user_id', ...) inside each transaction) for RLS policies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  BASIC
  PRO
  VIP
}

enum Exchange {
  BITGET
}

enum OrderSide {
  LONG
  SHORT
}

enum OrderStatus {
  PENDING
  PLACED
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  REJECTED
  FAILED
}

enum PositionStatus {
  OPEN
  CLOSED
  LIQUIDATED
}

enum HaltScope {
  USER
  SYSTEM
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email      String?  @unique
  name       String?
  avatarUrl  String?

  // subscription (backend-enforced)
  tier       SubscriptionTier @default(BASIC)
  tierUntil  DateTime?

  accounts   OAuthAccount[]
  sessions   Session[]

  exchangeKeys ExchangeKey[]
  riskLimits   RiskLimit?
  trades       Trade[]
  orders       Order[]
  tradeEvents  TradeEvent[]
  halts        TradingHalt[]
  auditLogs    AuditLog[]

  @@index([createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String   // "google" | "apple"
  providerAccountId String

  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // hashed token (never store raw session token)
  tokenSha256 String @unique

  @@index([userId])
  @@index([expiresAt])
}

model ExchangeKey {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastUsedAt DateTime?

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange Exchange @default(BITGET)
  label    String?

  // Fingerprints for dedupe + safe display
  apiKeyLast4   String
  apiKeySha256  String @unique

  // Encrypted secrets (AES-256-GCM)
  // Format: base64(iv) + "." + base64(tag) + "." + base64(ciphertext)
  encApiKey     String
  encApiSecret  String
  encPassphrase String?

  // Safety: withdraw permission must be disabled
  withdrawEnabled Boolean @default(false)

  @@index([userId, exchange])
  @@index([userId, createdAt])
}

model RiskLimit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Absolute guardrails (all backend-enforced)
  maxDailyLossUsd        Decimal @db.Decimal(18, 2) @default(100)
  maxOpenExposureUsd     Decimal @db.Decimal(18, 2) @default(200)
  maxConcurrentPositions Int     @default(1)

  // Hard switch
  tradingEnabled Boolean @default(false)
}

model TradingHalt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  clearedAt DateTime?

  scope     HaltScope
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String   // e.g. "API_DESYNC", "RISK_LIMIT", "SERVER_RESTART_SAFE_MODE"
  message   String
  metaJson  String?

  @@index([scope, createdAt])
  @@index([userId, createdAt])
}

model Order {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange Exchange  @default(BITGET)
  symbol   String

  side     OrderSide
  qty      Decimal   @db.Decimal(18, 8)
  leverage Int

  status   OrderStatus @default(PENDING)

  // Idempotency: same key => same logical order
  idempotencyKey String
  clientRequestId String?

  // Exchange identifiers (never trust these alone)
  exchangeOrderId String?

  // Failure info (never include secrets)
  errorCode   String?
  errorDetail String?

  // Link to resulting trade (paper/live)
  tradeId String?
  trade   Trade?  @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([symbol, createdAt])
}

model Trade {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchange Exchange @default(BITGET)
  symbol   String

  side     OrderSide
  status   PositionStatus @default(OPEN)

  entryTime DateTime
  entryPrice Decimal @db.Decimal(18, 8)
  entryQty   Decimal @db.Decimal(18, 8)

  exitTime   DateTime?
  exitPrice  Decimal? @db.Decimal(18, 8)
  realizedPnlUsd Decimal? @db.Decimal(18, 2)

  // Transparency: "why" + "risk context"
  rationaleJson String  // machine-readable explanation payload
  aiMetaJson    String? // confidence/strictness/regime/etc

  events TradeEvent[]
  orders Order[]

  @@index([userId, entryTime])
  @@index([symbol, entryTime])
}

model TradeEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  type    String  // ENTRY | EXIT | UPDATE | HALT | NOTE
  message String
  metaJson String?

  @@index([userId, createdAt])
  @@index([tradeId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId  String?
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action  String   // e.g. "EXCHANGE_KEY_CREATED", "TRADING_HALTED"
  ip      String?
  ua      String?

  // Never store secrets; metadata only
  metaJson String?

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

